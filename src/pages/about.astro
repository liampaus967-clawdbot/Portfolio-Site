---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
	<section class="about-header">
		<div class="about-intro">
			<h1>About Me</h1>
			<p class="tagline">GIS Developer · Vermont-based · Water-obsessed</p>
		</div>
	</section>

	<section class="about-content">
		<div class="about-main">
			<h2>Hey, I'm Liam 👋</h2>
			<p>
				I'm the <strong>Head of GIS & Mapping</strong> at <a href="https://onwater.com" target="_blank">onWater</a>, 
				where I lead all GIS engineering, spatial analytics, and cartographic initiatives for consumer web and mobile mapping platforms.
			</p>
			<p>
				With 6+ years of experience, I specialize in designing full-stack geospatial systems for outdoor recreation 
				and environmental intelligence products. I architect scalable data pipelines, develop predictive ML-powered 
				map layers, and translate complex spatial analytics into intuitive experiences that help millions of users 
				make better decisions on the water.
			</p>
			<p>
				I own the full GIS workflow — from ideation and prototyping through production deployment and PR submission. 
				Whether it's expanding map coverage into new international markets or building species intelligence layers, 
				I'm focused on turning static maps into living, dynamic products.
			</p>

			<h2>Experience</h2>
			<div class="experience-list">
				<div class="experience-item">
					<div class="exp-header">
						<h3>Head of GIS & Mapping</h3>
						<span class="exp-meta">onWater · Remote · Current</span>
					</div>
					<p>
						Lead all GIS engineering and cartographic initiatives. Architect scalable geospatial pipelines, 
						develop ML-powered predictive layers, and ship dynamic map features across web and mobile platforms.
						Expanded coverage into 3 new international markets.
					</p>
				</div>
				<div class="experience-item">
					<div class="exp-header">
						<h3>Maps Operator</h3>
						<span class="exp-meta">Uber · Contractor · 2021–Present</span>
					</div>
					<p>
						Large-scale spatial and statistical analysis using QGIS, PostgreSQL/PostGIS for routing optimization. 
						Lead cross-team initiatives and develop SQL-based analytical workflows.
					</p>
				</div>
				<div class="experience-item">
					<div class="exp-header">
						<h3>GIS Specialist</h3>
						<span class="exp-meta">Apple · Contractor · 2020</span>
					</div>
					<p>
						Geospatial data validation, cleansing, and QA at scale. Supported enterprise data workflows 
						and resolved 15+ spatial data tickets daily.
					</p>
				</div>
				<div class="experience-item">
					<div class="exp-header">
						<h3>GIS Intern</h3>
						<span class="exp-meta">Scheid Family Wines · 2019</span>
					</div>
					<p>
						Led irrigation infrastructure mapping modernization. Built NDVI, soil, and hydrology analyses. 
						Operated UAVs for orthomosaics and elevation models.
					</p>
				</div>
			</div>

			<h2>Education</h2>
			<div class="education-list">
				<div class="edu-item">
					<h3>Master of Geographic Information Systems (MGIS)</h3>
					<span class="edu-meta">Pennsylvania State University · Dec 2024</span>
				</div>
				<div class="edu-item">
					<h3>Graduate Certificate — Geospatial Programming & Web Map Development</h3>
					<span class="edu-meta">Pennsylvania State University · May 2023</span>
				</div>
				<div class="edu-item">
					<h3>Bachelor of Arts — Geography</h3>
					<span class="edu-meta">University of Vermont · May 2018</span>
				</div>
			</div>

			<h2>Technical Skills</h2>
			<div class="tech-grid">
				<div class="tech-category">
					<h3>GIS & Spatial</h3>
					<ul>
						<li>ArcGIS Pro & Enterprise</li>
						<li>QGIS</li>
						<li>PostGIS</li>
						<li>GeoServer</li>
					</ul>
				</div>
				<div class="tech-category">
					<h3>Web Mapping</h3>
					<ul>
						<li>Mapbox GL JS</li>
						<li>Leaflet</li>
						<li>ArcGIS JS API</li>
						<li>Vector Tiles</li>
					</ul>
				</div>
				<div class="tech-category">
					<h3>Development</h3>
					<ul>
						<li>Python (ArcPy)</li>
						<li>JavaScript / TypeScript</li>
						<li>SQL / PostgreSQL</li>
						<li>GDAL</li>
					</ul>
				</div>
				<div class="tech-category">
					<h3>Specializations</h3>
					<ul>
						<li>Spatial Data Pipelines</li>
						<li>ML-powered Map Layers</li>
						<li>Recreation Cartography</li>
						<li>Environmental Modeling</li>
					</ul>
				</div>
			</div>

			<h2>Get In Touch</h2>
			<p>
				I'm always interested in talking maps, geospatial tech, or outdoor adventures.
			</p>
			<div class="social-links">
				<a href="https://github.com/liampaus967-clawdbot" target="_blank" class="social-link">
					<span class="icon">💻</span> GitHub
				</a>
				<a href="https://linkedin.com/in/liampaus" target="_blank" class="social-link">
					<span class="icon">💼</span> LinkedIn
				</a>
				<a href="mailto:lpaus967@gmail.com" class="social-link">
					<span class="icon">📧</span> Email
				</a>
			</div>
		</div>

		<aside class="about-sidebar">
			<div class="sidebar-card">
				<h3>Currently</h3>
				<p>Head of GIS & Mapping<br/><a href="https://onwater.com" target="_blank">onWater</a></p>
			</div>
			<div class="sidebar-card">
				<h3>Location</h3>
				<p>Hyde Park, Vermont 🏔️</p>
			</div>
			<div class="sidebar-card">
				<h3>Focus Areas</h3>
				<p>Recreational Apps<br/>Water & Hydrology<br/>Environmental Data</p>
			</div>
			<div class="sidebar-card">
				<h3>Off the Clock</h3>
				<p>Skiing ⛷️<br/>Mountain Biking 🚵<br/>Fishing 🎣</p>
			</div>
		</aside>
	</section>
</Layout>

<style>
	.about-header {
		padding: 2rem 0 3rem;
	}

	.about-header h1 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.tagline {
		color: var(--text-muted);
		font-size: 1.25rem;
	}

	.about-content {
		display: grid;
		grid-template-columns: 1fr 280px;
		gap: 3rem;
	}

	.about-main h2 {
		font-size: 1.5rem;
		margin: 2.5rem 0 1rem;
	}

	.about-main h2:first-child {
		margin-top: 0;
	}

	.about-main p {
		color: var(--text-muted);
		line-height: 1.8;
		margin-bottom: 1rem;
		font-size: 1.05rem;
	}

	/* Experience */
	.experience-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.experience-item {
		padding: 1.25rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 12px;
	}

	.exp-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.75rem;
	}

	.exp-header h3 {
		font-size: 1.1rem;
		margin: 0;
	}

	.exp-meta {
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.experience-item p {
		margin: 0;
		font-size: 0.95rem;
	}

	/* Education */
	.education-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.edu-item {
		padding: 1rem 1.25rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 12px;
	}

	.edu-item h3 {
		font-size: 1rem;
		margin: 0 0 0.25rem 0;
	}

	.edu-meta {
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	/* Tech Grid */
	.tech-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.5rem;
		margin: 1.5rem 0;
	}

	.tech-category h3 {
		font-size: 0.9rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent);
		margin-bottom: 0.75rem;
	}

	.tech-category ul {
		list-style: none;
	}

	.tech-category li {
		color: var(--text-muted);
		padding: 0.25rem 0;
		font-size: 0.95rem;
	}

	/* Social Links */
	.social-links {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
		flex-wrap: wrap;
	}

	.social-link {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		padding: 0.75rem 1.25rem;
		border-radius: 8px;
		color: var(--text);
		transition: all 0.2s ease;
	}

	.social-link:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.icon {
		font-size: 1.1rem;
	}

	/* Sidebar */
	.about-sidebar {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.sidebar-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.25rem;
	}

	.sidebar-card h3 {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}

	.sidebar-card p {
		font-size: 1rem;
		line-height: 1.6;
	}

	@media (max-width: 768px) {
		.about-header h1 {
			font-size: 2rem;
		}

		.about-content {
			grid-template-columns: 1fr;
		}

		.about-sidebar {
			flex-direction: row;
			flex-wrap: wrap;
		}

		.sidebar-card {
			flex: 1 1 150px;
		}

		.tech-grid {
			grid-template-columns: 1fr;
		}

		.exp-header {
			flex-direction: column;
		}
	}
</style>
