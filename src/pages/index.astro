---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Liam | GIS & Mapping">
	<section class="hero">
		<div class="hero-map" id="hero-map"></div>
		<div class="hero-overlay"></div>
		<div class="hero-content">
			<p class="hero-label">GIS & Mapping Specialist</p>
			<h1>I build maps that <span class="accent">move</span> people.</h1>
			<p class="intro">
				Head of GIS at <a href="https://onwater.com" target="_blank">onWater</a>. 
				I turn massive geospatial datasets into beautiful, interactive experiences 
				for millions of anglers and paddlers.
			</p>
			<div class="cta-buttons">
				<a href="/projects" class="btn btn-primary">View Projects</a>
				<a href="/sandbox" class="btn btn-secondary">🗺️ Map Sandbox</a>
			</div>
		</div>
	</section>

	<section class="stats">
		<div class="stat">
			<span class="stat-number" data-target="500">0</span><span class="stat-suffix">M+</span>
			<span class="stat-label">Map Views</span>
		</div>
		<div class="stat">
			<span class="stat-number" data-target="50">0</span><span class="stat-suffix">TB</span>
			<span class="stat-label">Geodata Processed</span>
		</div>
		<div class="stat">
			<span class="stat-number" data-target="12">0</span><span class="stat-suffix">+</span>
			<span class="stat-label">Custom Map Styles</span>
		</div>
		<div class="stat">
			<span class="stat-number" data-target="3">0</span><span class="stat-suffix">M</span>
			<span class="stat-label">Users Served</span>
		</div>
	</section>

	<section class="expertise">
		<h2>What I Do</h2>
		<p class="section-intro">Specialized in water-focused geospatial work — from data pipelines to production maps.</p>
		<div class="expertise-grid">
			<div class="expertise-card">
				<div class="expertise-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
				</div>
				<h3>Interactive Mapping</h3>
				<p>Custom Mapbox GL JS applications with vector tiles, 3D terrain, and real-time data layers.</p>
			</div>
			<div class="expertise-card">
				<div class="expertise-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
						<polyline points="14 2 14 8 20 8"></polyline>
						<line x1="16" y1="13" x2="8" y2="13"></line>
						<line x1="16" y1="17" x2="8" y2="17"></line>
						<polyline points="10 9 9 9 8 9"></polyline>
					</svg>
				</div>
				<h3>Data Engineering</h3>
				<p>Processing terabytes of raster and vector data — HRRR weather, NHD hydrology, bathymetry, and more.</p>
			</div>
			<div class="expertise-card">
				<div class="expertise-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
					</svg>
				</div>
				<h3>Hydrology & Water</h3>
				<p>Deep expertise in waterway data — rivers, lakes, watersheds, flowlines, and aquatic ecosystems.</p>
			</div>
			<div class="expertise-card">
				<div class="expertise-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
						<polyline points="2 17 12 22 22 17"></polyline>
						<polyline points="2 12 12 17 22 12"></polyline>
					</svg>
				</div>
				<h3>Tile Pipelines</h3>
				<p>Building scalable vector tile infrastructure with tippecanoe, PMTiles, and cloud delivery.</p>
			</div>
		</div>
	</section>

	<section class="featured">
		<h2>Featured Work</h2>
		<p class="section-intro">Recent projects I'm proud of.</p>
		<div class="featured-grid">
			<a href="/projects" class="featured-card featured-large">
				<div class="featured-image" id="featured-map-1"></div>
				<div class="featured-overlay"></div>
				<div class="featured-content">
					<span class="featured-tag">Flagship Product</span>
					<h3>onWater Map Platform</h3>
					<p>Interactive fishing maps serving millions of anglers with real-time conditions, spots, and navigation.</p>
				</div>
			</a>
			<a href="/projects" class="featured-card">
				<div class="featured-image" style="background: linear-gradient(135deg, #134e4a 0%, #0f172a 100%);"></div>
				<div class="featured-overlay"></div>
				<div class="featured-content">
					<span class="featured-tag">Mobile App</span>
					<h3>Paddleways</h3>
					<p>Route planning for kayakers with water levels and access points.</p>
				</div>
			</a>
			<a href="/projects" class="featured-card">
				<div class="featured-image" style="background: linear-gradient(135deg, #4c1d95 0%, #0f172a 100%);"></div>
				<div class="featured-overlay"></div>
				<div class="featured-content">
					<span class="featured-tag">Real-time Data</span>
					<h3>HRRR Weather Viz</h3>
					<p>Animated weather layers from NOAA's rapid refresh system.</p>
				</div>
			</a>
		</div>
		<div class="featured-cta">
			<a href="/projects" class="btn btn-outline">View All Projects →</a>
		</div>
	</section>

	<section class="cta-section">
		<div class="cta-content">
			<h2>Let's build something</h2>
			<p>Interested in working together or just want to talk maps?</p>
			<a href="/about" class="btn btn-primary">Get in Touch</a>
		</div>
	</section>
</Layout>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
<script is:inline src="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.js"></script>

<style>
	/* Hero Section - Full Width */
	.hero {
		position: relative;
		min-height: 90vh;
		display: flex;
		align-items: center;
		overflow: hidden;
		margin-left: calc(-50vw + 50%);
		margin-right: calc(-50vw + 50%);
		width: 100vw;
		padding: 0 max(2rem, calc((100vw - 1200px) / 2 + 2rem));
	}

	.hero-map {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, rgba(10, 10, 10, 0.85) 0%, rgba(10, 10, 10, 0.6) 100%);
		z-index: 1;
	}

	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 700px;
		padding: 4rem 0;
	}

	.hero-label {
		text-transform: uppercase;
		letter-spacing: 0.15em;
		font-size: 0.85rem;
		color: var(--accent);
		margin-bottom: 1rem;
		font-weight: 500;
	}

	.hero h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 700;
		line-height: 1.1;
		margin-bottom: 1.5rem;
	}

	.hero h1 .accent {
		background: linear-gradient(135deg, var(--accent) 0%, #60a5fa 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero .intro {
		font-size: 1.15rem;
		line-height: 1.7;
		color: var(--text-muted);
		margin-bottom: 2rem;
		max-width: 550px;
	}

	.cta-buttons {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.btn {
		padding: 0.875rem 1.75rem;
		border-radius: 8px;
		font-weight: 500;
		font-size: 0.95rem;
		transition: all 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.btn-primary {
		background: var(--accent);
		color: white;
	}

	.btn-primary:hover {
		background: var(--accent-hover);
		color: white;
		transform: translateY(-2px);
	}

	.btn-secondary {
		background: rgba(255, 255, 255, 0.1);
		color: var(--text);
		border: 1px solid rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(8px);
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.15);
		color: var(--text);
	}

	.btn-outline {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
	}

	.btn-outline:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Stats Section */
	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
		padding: 4rem 0;
		border-bottom: 1px solid var(--border);
	}

	.stat {
		text-align: center;
	}

	.stat-number {
		font-size: 3rem;
		font-weight: 700;
		color: var(--accent);
	}

	.stat-suffix {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--accent);
	}

	.stat-label {
		display: block;
		margin-top: 0.5rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	/* Expertise Section */
	.expertise {
		padding: 5rem 0;
	}

	.expertise h2,
	.featured h2 {
		font-size: 2.25rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.section-intro {
		color: var(--text-muted);
		font-size: 1.1rem;
		margin-bottom: 3rem;
	}

	.expertise-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.5rem;
	}

	.expertise-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 2rem;
		transition: all 0.3s ease;
	}

	.expertise-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
	}

	.expertise-icon {
		width: 48px;
		height: 48px;
		background: rgba(96, 165, 250, 0.1);
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.25rem;
	}

	.expertise-icon svg {
		width: 24px;
		height: 24px;
		color: var(--accent);
	}

	.expertise-card h3 {
		font-size: 1.15rem;
		margin-bottom: 0.75rem;
	}

	.expertise-card p {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	/* Featured Section */
	.featured {
		padding: 5rem 0;
		border-top: 1px solid var(--border);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-template-rows: auto auto;
		gap: 1.5rem;
	}

	.featured-card {
		position: relative;
		border-radius: 16px;
		overflow: hidden;
		min-height: 280px;
		display: flex;
		align-items: flex-end;
		text-decoration: none;
		transition: transform 0.3s ease;
	}

	.featured-card:hover {
		transform: translateY(-4px);
	}

	.featured-large {
		grid-row: span 2;
		min-height: 580px;
	}

	.featured-image {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
	}

	.featured-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.3) 50%, transparent 100%);
	}

	.featured-content {
		position: relative;
		z-index: 2;
		padding: 2rem;
	}

	.featured-tag {
		display: inline-block;
		background: var(--accent);
		color: white;
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		padding: 0.35rem 0.75rem;
		border-radius: 4px;
		margin-bottom: 1rem;
	}

	.featured-content h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
		color: white;
	}

	.featured-large .featured-content h3 {
		font-size: 2rem;
	}

	.featured-content p {
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.featured-cta {
		text-align: center;
		margin-top: 3rem;
	}

	/* CTA Section */
	.cta-section {
		padding: 6rem 0;
		text-align: center;
		border-top: 1px solid var(--border);
	}

	.cta-content h2 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.cta-content p {
		color: var(--text-muted);
		font-size: 1.1rem;
		margin-bottom: 2rem;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.hero {
			min-height: 80vh;
			padding: 0 1.5rem;
		}

		.hero-content {
			padding: 3rem 0;
		}

		.stats {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}

		.stat-number {
			font-size: 2rem;
		}

		.featured-grid {
			grid-template-columns: 1fr;
		}

		.featured-large {
			grid-row: span 1;
			min-height: 320px;
		}

		.cta-content h2 {
			font-size: 1.75rem;
		}
	}
</style>

<script is:inline>
	const MAPBOX_TOKEN = 'pk.eyJ1Ijoib253YXRlcmxsYyIsImEiOiJja3poaWFjbnc0MjVrMm9tem5kenVqd3h3In0.2yMEyumU5erOQ6B5GadT5w';

	document.addEventListener('DOMContentLoaded', () => {
		// Initialize hero map
		if (typeof mapboxgl !== 'undefined' && MAPBOX_TOKEN) {
			mapboxgl.accessToken = MAPBOX_TOKEN;

			const heroMap = new mapboxgl.Map({
				container: 'hero-map',
				style: 'mapbox://styles/mapbox/satellite-streets-v12',
				center: [-72.6874, 44.4654], // Stowe, VT
				zoom: 11,
				pitch: 45,
				bearing: -10,
				interactive: false,
				attributionControl: false
			});

			heroMap.on('load', () => {
				// Add custom rivers tileset
				heroMap.addSource('subsetRivers', {
					type: 'vector',
					url: 'mapbox://lman967.6hxqcksb'
				});

				heroMap.addLayer({
					id: 'subsetRivers-layer',
					type: 'line',
					source: 'subsetRivers',
					'source-layer': 'subsetRivers-d1irb0',
					paint: {
						'line-color': '#60a5fa',
						'line-width': 2,
						'line-opacity': 0.8
					}
				});

				// Slow pan animation
				let bearing = -10;
				function rotateCamera() {
					bearing += 0.01;
					heroMap.setBearing(bearing);
					requestAnimationFrame(rotateCamera);
				}
				rotateCamera();
			});

			// Featured project map
			const featuredMap = new mapboxgl.Map({
				container: 'featured-map-1',
				style: '/styles/fishing-outdoor.json',
				center: [-93.2, 45.0],
				zoom: 8,
				interactive: false,
				attributionControl: false
			});
		}

		// Animate stats on scroll
		const statNumbers = document.querySelectorAll('.stat-number');
		const observer = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const target = parseInt(entry.target.dataset.target);
					animateNumber(entry.target, target);
					observer.unobserve(entry.target);
				}
			});
		}, { threshold: 0.5 });

		statNumbers.forEach(num => observer.observe(num));

		function animateNumber(el, target) {
			let current = 0;
			const increment = target / 50;
			const timer = setInterval(() => {
				current += increment;
				if (current >= target) {
					el.textContent = target;
					clearInterval(timer);
				} else {
					el.textContent = Math.floor(current);
				}
			}, 30);
		}
	});
</script>
