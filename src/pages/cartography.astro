---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: "Mayfly Flywheel Engraving",
		description: "Led cartographic design for Abel Reels' custom fly fishing reel engraving. Topographic contours and hydrological network etched into machined aluminum.",
		image: "/images/cartography/flywheel-engraving.png",
		tags: ["Product Design", "Engraving", "Topography", "Abel Reels"],
		client: "Abel Reels"
	},
	{
		title: "The Blue Line Project Vehicle Wrap",
		description: "Designed hydrological map graphics for Rivian truck wrap. Features river networks and topographic elements for Airflo's conservation initiative.",
		image: "/images/cartography/vehicle-wrap.png",
		tags: ["Vehicle Graphics", "Brand Design", "Hydrology", "Airflo"],
		client: "Airflo / The Blue Line Project"
	},
	{
		title: "Fly Shop Regional Map",
		description: "Custom cartographic map for Montana fly shop showing fishing access sites, river sections, public lands, and key landmarks for anglers.",
		image: "/images/cartography/flyshop-map.png",
		tags: ["Print Map", "Fishing Access", "Montana", "Retail"],
		client: "Fly Shop",
		portrait: true
	},
	{
		title: "National Hydrological Visualization",
		description: "High-resolution visualization of the complete US river network overlaid on satellite imagery. Every stream and river rendered from NHDPlus data.",
		image: "/images/cartography/hydrology-visual.png",
		tags: ["Data Visualization", "NHDPlus", "Satellite", "Rivers"],
		client: "onWater"
	},
	{
		title: "Firefly POI Density Map",
		description: "\"Firefly\" style visualization showing density of fishing points of interest across the United States. Millions of POIs rendered as glowing points.",
		image: "/images/cartography/firefly-visual.png",
		tags: ["Data Visualization", "POI", "Density Map", "Firefly Style"],
		client: "onWater"
	}
];
---

<Layout title="Cartography">
	<section class="page-header">
		<h1>Cartography</h1>
		<p>Custom map design, data visualization, and cartographic products for outdoor brands and applications.</p>
	</section>

	<section class="gallery">
		{projects.map((project, index) => (
			<article class={`gallery-item ${index === 0 ? 'featured' : ''} ${project.portrait ? 'portrait' : ''}`}>
				<div class="gallery-image">
					<img src={project.image} alt={project.title} loading="lazy" />
				</div>
				<div class="gallery-content">
					<div class="gallery-meta">
						<span class="client">{project.client}</span>
					</div>
					<h2>{project.title}</h2>
					<p>{project.description}</p>
					<div class="tags">
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</div>
			</article>
		))}
	</section>

	<section class="cta-section">
		<h2>Need Custom Cartography?</h2>
		<p>From product engravings to large-format prints, I create maps that tell stories.</p>
		<a href="/about" class="btn btn-primary">Get in Touch</a>
	</section>
</Layout>

<style>
	.page-header {
		padding: 2rem 0 3rem;
	}

	.page-header h1 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.page-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
		max-width: 600px;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
		padding-bottom: 4rem;
	}

	.gallery-item {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 20px;
		overflow: hidden;
		transition: all 0.3s ease;
	}

	.gallery-item:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
		box-shadow: 0 20px 40px -15px rgba(0, 180, 216, 0.15);
	}

	.gallery-item.featured {
		grid-column: span 2;
	}

	.gallery-image {
		width: 100%;
		overflow: hidden;
		background: #0a0a0a;
		aspect-ratio: 16 / 10;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.gallery-item.featured .gallery-image {
		max-height: 500px;
		aspect-ratio: auto;
	}

	.gallery-item.portrait .gallery-image {
		aspect-ratio: 3 / 4;
	}

	.gallery-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		transition: transform 0.5s ease;
	}

	.gallery-item:hover .gallery-image img {
		transform: scale(1.02);
	}

	.gallery-content {
		padding: 1.75rem;
	}

	.gallery-meta {
		margin-bottom: 0.75rem;
	}

	.client {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent);
	}

	.gallery-content h2 {
		font-size: 1.4rem;
		margin-bottom: 0.75rem;
		color: var(--text);
	}

	.gallery-content p {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.7;
		margin-bottom: 1.25rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 0.3rem 0.85rem;
		border-radius: 9999px;
		font-size: 0.72rem;
		color: var(--text-muted);
	}

	.cta-section {
		padding: 4rem 0;
		text-align: center;
		border-top: 1px solid var(--border);
	}

	.cta-section h2 {
		font-size: 2rem;
		margin-bottom: 0.75rem;
	}

	.cta-section p {
		color: var(--text-muted);
		font-size: 1.1rem;
		margin-bottom: 2rem;
	}

	.btn {
		padding: 0.875rem 1.75rem;
		border-radius: 8px;
		font-weight: 500;
		font-size: 0.95rem;
		transition: all 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}

	.btn-primary {
		background: var(--accent);
		color: white;
	}

	.btn-primary:hover {
		background: var(--accent-hover);
		color: white;
		transform: translateY(-2px);
	}

	@media (max-width: 768px) {
		.page-header h1 {
			font-size: 2rem;
		}

		.gallery {
			grid-template-columns: 1fr;
		}

		.gallery-item.featured {
			grid-column: span 1;
		}

		.gallery-image {
			aspect-ratio: 16 / 9;
		}

		.gallery-item.featured .gallery-image {
			max-height: 300px;
			aspect-ratio: auto;
		}

		.gallery-item.portrait .gallery-image {
			aspect-ratio: 2 / 3;
		}
	}
</style>
