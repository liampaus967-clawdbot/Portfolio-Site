---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: "NHDPlus Hydrology Explorer",
		description: "Interactive exploration tool for the National Hydrography Dataset. Trace upstream/downstream flow paths, analyze watersheds, and query 2.7 million stream segments.",
		tags: ["NHDPlus", "Hydrology", "Vector Tiles", "PostGIS"],
		emoji: "💧",
		gradient: "linear-gradient(135deg, #1e40af 0%, #0f172a 100%)",
		status: "In Development"
	},
	{
		title: "Stream Temperature Modeling",
		description: "Research into predicting stream temperatures using NHD Plus attributes, weather data, and machine learning. Potential applications for fisheries management.",
		tags: ["Machine Learning", "HRRR", "NHDPlus", "Python"],
		emoji: "🌡️",
		gradient: "linear-gradient(135deg, #dc2626 0%, #0f172a 100%)",
		status: "Research"
	},
	{
		title: "Bathymetry Visualization",
		description: "Depth visualization experiments for lakes and reservoirs. Processing sonar data and integrating with topographic models for seamless land-to-water transitions.",
		tags: ["Bathymetry", "3D Terrain", "Raster Processing", "Mapbox"],
		emoji: "🌊",
		gradient: "linear-gradient(135deg, #0891b2 0%, #0f172a 100%)",
		status: "Prototype"
	},
	{
		title: "CNC Topo Maps",
		description: "Exploring CNC machining for physical 3D topographic maps. Combining DEM data with hydrography for laser-cut or routed wooden watershed art.",
		tags: ["DEM", "CNC", "Physical Maps", "QGIS"],
		emoji: "🏔️",
		gradient: "linear-gradient(135deg, #65a30d 0%, #0f172a 100%)",
		status: "Concept"
	}
];

const statusColors: Record<string, string> = {
	"Live Demo": "#22c55e",
	"In Development": "#3b82f6",
	"Research": "#f59e0b",
	"Prototype": "#8b5cf6",
	"Concept": "#6b7280"
};
---

<Layout title="Research">
	<section class="page-header">
		<h1>Research & Side Projects</h1>
		<p>Personal explorations in hydrology, geospatial data, and outdoor tech.</p>
	</section>

	<section class="projects-grid">
		{projects.map((project) => (
			<article class="project-card">
				<div class="project-image" style={`background: ${project.gradient}`}>
					<span class="project-emoji">{project.emoji}</span>
					{project.status && (
						<span class="project-status" style={`background: ${statusColors[project.status]}`}>
							{project.status}
						</span>
					)}
				</div>
				<div class="project-content">
					<div class="project-header">
						<h2>{project.title}</h2>
						{project.link && (
							<a href={project.link} class="project-link" title="View project">→</a>
						)}
					</div>
					<p>{project.description}</p>
					<div class="tags">
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</div>
			</article>
		))}
	</section>

	<section class="ideas-section">
		<h2>💡 Ideas Backlog</h2>
		<p>Things I want to build when I find the time:</p>
		<ul class="ideas-list">
			<li>National river access point database with parking, amenities, and user reviews</li>
			<li>Real-time USGS gauge dashboard with historical comparisons</li>
			<li>Watershed-based fishing regulations lookup tool</li>
			<li>Strava-style activity tracking for paddlers with river segments</li>
		</ul>
	</section>
</Layout>

<style>
	.page-header {
		padding: 2rem 0 3rem;
	}

	.page-header h1 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.page-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
		padding-bottom: 4rem;
	}

	.project-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
	}

	.project-image {
		height: 180px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
	}

	.project-emoji {
		font-size: 4rem;
	}

	.project-status {
		position: absolute;
		top: 1rem;
		right: 1rem;
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.7rem;
		font-weight: 600;
		color: white;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.project-content {
		padding: 1.5rem;
	}

	.project-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
	}

	.project-header h2 {
		font-size: 1.25rem;
		margin: 0;
	}

	.project-link {
		font-size: 1.25rem;
		color: var(--text-muted);
		transition: color 0.2s;
	}

	.project-link:hover {
		color: var(--accent);
	}

	.project-content p {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.ideas-section {
		padding: 3rem 0;
		border-top: 1px solid var(--border);
	}

	.ideas-section h2 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.ideas-section > p {
		color: var(--text-muted);
		margin-bottom: 1.5rem;
	}

	.ideas-list {
		list-style: none;
		display: grid;
		gap: 0.75rem;
	}

	.ideas-list li {
		padding: 1rem 1.25rem;
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 8px;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.ideas-list li::before {
		content: "→ ";
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.page-header h1 {
			font-size: 2rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
