---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: "onWater Map Platform",
		description: "Lead development of the interactive mapping platform powering onWater's fishing app. Built custom vector tile pipelines, real-time weather overlays, and location-based fishing spot discovery for millions of anglers.",
		tags: ["Mapbox GL JS", "Vector Tiles", "PostGIS", "Node.js", "React Native"],
		emoji: "🎣",
		gradient: "linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%)",
		link: "https://onwater.com"
	},
	{
		title: "Paddleways",
		description: "Mapping platform for kayakers and canoeists. Features route planning, real-time water level conditions from USGS gauges, and access point discovery across thousands of waterways.",
		tags: ["Mapbox GL JS", "React", "USGS Data", "Route Planning"],
		emoji: "🛶",
		gradient: "linear-gradient(135deg, #134e4a 0%, #0f172a 100%)",
		link: "https://paddleways.com"
	},
	{
		title: "HRRR Weather Visualization",
		description: "Real-time weather raster visualization using NOAA's High-Resolution Rapid Refresh data. Animated precipitation, wind, and temperature layers integrated into onWater's fishing conditions.",
		tags: ["Raster Processing", "HRRR", "NOAA", "WebGL", "COG"],
		emoji: "🌦️",
		gradient: "linear-gradient(135deg, #4c1d95 0%, #0f172a 100%)"
	},
	{
		title: "Custom Outdoor Cartography",
		description: "12+ custom map styles designed for outdoor recreation apps. Optimized for readability on mobile devices with water features prominently displayed.",
		tags: ["Cartography", "Mapbox Studio", "Mobile Design", "Typography"],
		emoji: "🗺️",
		gradient: "linear-gradient(135deg, #7c2d12 0%, #0f172a 100%)"
	}
];
---

<Layout title="Work">
	<section class="page-header">
		<h1>Work</h1>
		<p>Professional projects at <a href="https://onwater.com" target="_blank">onWater</a> — building maps for anglers and paddlers.</p>
	</section>

	<section class="projects-grid">
		{projects.map((project) => (
			<article class="project-card">
				<div class="project-image" style={`background: ${project.gradient}`}>
					<span class="project-emoji">{project.emoji}</span>
				</div>
				<div class="project-content">
					<div class="project-header">
						<h2>{project.title}</h2>
						{project.link && (
							<a href={project.link} target="_blank" class="project-link" title="Visit site">↗</a>
						)}
					</div>
					<p>{project.description}</p>
					<div class="tags">
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</div>
			</article>
		))}
	</section>

	<section class="work-stats">
		<h2>Impact</h2>
		<div class="stats-grid">
			<div class="stat-card">
				<span class="stat-number">500M+</span>
				<span class="stat-label">Map tile requests served</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">3M+</span>
				<span class="stat-label">Active users</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">50TB+</span>
				<span class="stat-label">Geodata processed</span>
			</div>
			<div class="stat-card">
				<span class="stat-number">12+</span>
				<span class="stat-label">Custom map styles</span>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		padding: 2rem 0 3rem;
	}

	.page-header h1 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.page-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
		padding-bottom: 4rem;
	}

	.project-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
	}

	.project-image {
		height: 180px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.project-emoji {
		font-size: 4rem;
	}

	.project-content {
		padding: 1.5rem;
	}

	.project-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.75rem;
	}

	.project-header h2 {
		font-size: 1.25rem;
		margin: 0;
	}

	.project-link {
		font-size: 1.25rem;
		color: var(--text-muted);
		transition: color 0.2s;
	}

	.project-link:hover {
		color: var(--accent);
	}

	.project-content p {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.work-stats {
		padding: 3rem 0;
		border-top: 1px solid var(--border);
	}

	.work-stats h2 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
	}

	.stat-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 1.5rem;
		text-align: center;
	}

	.stat-number {
		display: block;
		font-size: 2rem;
		font-weight: 700;
		color: var(--accent);
		margin-bottom: 0.25rem;
	}

	.stat-label {
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	@media (max-width: 640px) {
		.page-header h1 {
			font-size: 2rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
