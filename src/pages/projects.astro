---
import Layout from '../layouts/Layout.astro';

const projects = [
	{
		title: "onWater Map Platform",
		description: "Lead development of the interactive mapping platform powering onWater's fishing app. Built custom vector tile pipelines, real-time weather overlays, and location-based fishing spot discovery.",
		tags: ["Mapbox GL JS", "Vector Tiles", "PostGIS", "Node.js"],
		emoji: "🎣",
		gradient: "linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%)"
	},
	{
		title: "Paddleways",
		description: "Mapping paddle routes for kayakers and canoeists. Features include route planning, water level conditions, and access point discovery across thousands of waterways.",
		tags: ["Mapbox GL JS", "React", "USGS Data", "Route Planning"],
		emoji: "🛶",
		gradient: "linear-gradient(135deg, #134e4a 0%, #0f172a 100%)"
	},
	{
		title: "HRRR Weather Visualization",
		description: "Real-time weather raster visualization using NOAA's High-Resolution Rapid Refresh data. Animated precipitation, wind, and temperature layers on interactive maps.",
		tags: ["Raster Processing", "HRRR", "Mapbox", "WebGL"],
		emoji: "🌦️",
		gradient: "linear-gradient(135deg, #4c1d95 0%, #0f172a 100%)"
	},
	{
		title: "NHDPlus Hydrology Explorer",
		description: "Interactive exploration tool for the National Hydrography Dataset. Trace upstream/downstream flow paths, analyze watersheds, and query stream characteristics.",
		tags: ["NHDPlus", "Hydrology", "Vector Tiles", "Analysis"],
		emoji: "💧",
		gradient: "linear-gradient(135deg, #0369a1 0%, #0f172a 100%)"
	},
	{
		title: "Bathymetry Mapping",
		description: "Depth visualization for lakes and reservoirs. Processing sonar data and integrating with topographic models for seamless land-to-water transitions.",
		tags: ["Bathymetry", "3D Terrain", "Data Processing", "Mapbox"],
		emoji: "🌊",
		gradient: "linear-gradient(135deg, #1e40af 0%, #0f172a 100%)"
	},
	{
		title: "Custom Cartography",
		description: "Various cartographic projects including custom map styles, label placement algorithms, and print-ready map generation for outdoor recreation.",
		tags: ["Cartography", "Design", "Print Maps", "Styling"],
		emoji: "🗺️",
		gradient: "linear-gradient(135deg, #7c2d12 0%, #0f172a 100%)"
	}
];
---

<Layout title="Projects">
	<section class="projects-header">
		<h1>Projects</h1>
		<p>A collection of mapping and geospatial projects I've worked on.</p>
	</section>

	<section class="projects-grid">
		{projects.map((project) => (
			<article class="project-card">
				<div class="project-image" style={`background: ${project.gradient}`}>
					<span class="project-emoji">{project.emoji}</span>
				</div>
				<div class="project-content">
					<h2>{project.title}</h2>
					<p>{project.description}</p>
					<div class="tags">
						{project.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</div>
			</article>
		))}
	</section>

	<section class="more-work">
		<h2>Want to see more?</h2>
		<p>Check out my <a href="/sandbox">sandbox</a> for experimental maps, or <a href="https://github.com/liampaus967-clawdbot" target="_blank">follow me on GitHub</a>.</p>
	</section>
</Layout>

<style>
	.projects-header {
		padding: 2rem 0 3rem;
	}

	.projects-header h1 {
		font-size: 3rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	.projects-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
		gap: 2rem;
		padding-bottom: 4rem;
	}

	.project-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 16px;
		overflow: hidden;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
	}

	.project-image {
		height: 180px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.project-emoji {
		font-size: 4rem;
	}

	.project-content {
		padding: 1.5rem;
	}

	.project-content h2 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
	}

	.project-content p {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		background: var(--bg);
		border: 1px solid var(--border);
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.more-work {
		text-align: center;
		padding: 3rem 0;
		border-top: 1px solid var(--border);
	}

	.more-work h2 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.more-work p {
		color: var(--text-muted);
	}

	@media (max-width: 640px) {
		.projects-header h1 {
			font-size: 2rem;
		}

		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
