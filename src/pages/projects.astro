---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Projects">
	<section class="redirect-page">
		<h1>Projects have moved!</h1>
		<p>I've reorganized my portfolio into two sections:</p>
		<div class="redirect-links">
			<a href="/work" class="redirect-link">
				<span class="emoji">💼</span>
				<span class="label">Work</span>
				<span class="desc">Professional projects at onWater</span>
			</a>
			<a href="/research" class="redirect-link">
				<span class="emoji">🔬</span>
				<span class="label">Research</span>
				<span class="desc">Personal projects & experiments</span>
			</a>
		</div>
	</section>
</Layout>

<style>
	.redirect-page {
		text-align: center;
		padding: 4rem 0;
	}

	.redirect-page h1 {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.redirect-page > p {
		color: var(--text-muted);
		margin-bottom: 2rem;
	}

	.redirect-links {
		display: flex;
		gap: 1.5rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.redirect-link {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 2rem;
		min-width: 200px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		transition: border-color 0.2s, transform 0.2s;
	}

	.redirect-link:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
	}

	.redirect-link .emoji {
		font-size: 2.5rem;
	}

	.redirect-link .label {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--text);
	}

	.redirect-link .desc {
		font-size: 0.85rem;
		color: var(--text-muted);
	}
</style>
