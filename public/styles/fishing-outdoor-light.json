{
  "version": 8,
  "name": "Fishing & Outdoor - Light (onX Style)",
  "metadata": {
    "author": "Sandy for Liam",
    "description": "Light outdoor map inspired by onX Fish - sage/cream land, cyan water, golden roads"
  },
  "sources": {
    "mapbox": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-streets-v8"
    },
    "mapbox-terrain": {
      "type": "vector",
      "url": "mapbox://mapbox.mapbox-terrain-v2"
    },
    "mapbox-dem": {
      "type": "raster-dem",
      "url": "mapbox://mapbox.mapbox-terrain-dem-v1",
      "tileSize": 512,
      "maxzoom": 14
    }
  },
  "terrain": {
    "source": "mapbox-dem",
    "exaggeration": 1.2
  },
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sprite": "mapbox://sprites/mapbox/outdoors-v12",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#e8e6d8"
      }
    },
    {
      "id": "hillshade",
      "type": "hillshade",
      "source": "mapbox-dem",
      "paint": {
        "hillshade-shadow-color": "#b8a888",
        "hillshade-highlight-color": "#f5f4ee",
        "hillshade-accent-color": "#c8b898",
        "hillshade-exaggeration": 0.3,
        "hillshade-illumination-direction": 315
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#c8d8b8",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {
        "fill-color": "#d8e4c8",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "landcover-scrub",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "landcover",
      "filter": ["==", "class", "scrub"],
      "paint": {
        "fill-color": "#d0dcc0",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "national-park",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "landuse_overlay",
      "filter": ["==", "class", "national_park"],
      "paint": {
        "fill-color": "#b8d0a8",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "landuse",
      "filter": ["==", "class", "park"],
      "paint": {
        "fill-color": "#c0d8b0",
        "fill-opacity": 0.4
      }
    },
    {
      "id": "wetland",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "landuse",
      "filter": ["==", "class", "wetland"],
      "paint": {
        "fill-color": "#a8d8c8",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "mapbox",
      "source-layer": "water",
      "paint": {
        "fill-color": "#8ed4e8"
      }
    },
    {
      "id": "water-outline",
      "type": "line",
      "source": "mapbox",
      "source-layer": "water",
      "paint": {
        "line-color": "#6bc4d8",
        "line-width": 1
      }
    },
    {
      "id": "waterway-river",
      "type": "line",
      "source": "mapbox",
      "source-layer": "waterway",
      "filter": ["==", "class", "river"],
      "paint": {
        "line-color": "#6bc4d8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 3, 18, 8]
      }
    },
    {
      "id": "waterway-stream",
      "type": "line",
      "source": "mapbox",
      "source-layer": "waterway",
      "filter": ["==", "class", "stream"],
      "paint": {
        "line-color": "#7ccce0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 1.5, 18, 4]
      }
    },
    {
      "id": "contour-line",
      "type": "line",
      "source": "mapbox-terrain",
      "source-layer": "contour",
      "filter": ["!=", "index", 5],
      "paint": {
        "line-color": "#a0b090",
        "line-width": 0.6,
        "line-opacity": 0.5
      }
    },
    {
      "id": "contour-line-index",
      "type": "line",
      "source": "mapbox-terrain",
      "source-layer": "contour",
      "filter": ["==", "index", 5],
      "paint": {
        "line-color": "#8a9a78",
        "line-width": 1,
        "line-opacity": 0.65
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["==", "class", "path"],
      "paint": {
        "line-color": "#b8a888",
        "line-width": 1,
        "line-dasharray": [2, 2]
      },
      "minzoom": 12
    },
    {
      "id": "road-track",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["==", "class", "track"],
      "paint": {
        "line-color": "#c0a878",
        "line-width": 1.5
      },
      "minzoom": 11
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["in", "class", "minor", "service"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 14, 2.5, 18, 7]
      },
      "minzoom": 10
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#a89060",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 2.5, 12, 5, 18, 14]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["==", "class", "secondary"],
      "paint": {
        "line-color": "#d4b878",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 12, 3.5, 18, 11]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#a08850",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.5, 12, 6, 18, 18]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#d4b068",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 12, 4, 18, 14]
      }
    },
    {
      "id": "road-trunk-casing",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["in", "class", "trunk", "motorway"],
      "paint": {
        "line-color": "#c89840",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.5, 10, 5, 14, 10, 18, 22]
      }
    },
    {
      "id": "road-trunk",
      "type": "line",
      "source": "mapbox",
      "source-layer": "road",
      "filter": ["in", "class", "trunk", "motorway"],
      "paint": {
        "line-color": "#e8c070",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 10, 3, 14, 7, 18, 17]
      }
    },
    {
      "id": "admin-state",
      "type": "line",
      "source": "mapbox",
      "source-layer": "admin",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#a0988c",
        "line-width": 1,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "admin-country",
      "type": "line",
      "source": "mapbox",
      "source-layer": "admin",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#908880",
        "line-width": 1.5
      }
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "mapbox",
      "source-layer": "water_label",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Italic", "Arial Unicode MS Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 14, 14],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#2a7a8a",
        "text-halo-color": "#e8e6d8",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "waterway-label",
      "type": "symbol",
      "source": "mapbox",
      "source-layer": "waterway_label",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Italic", "Arial Unicode MS Regular"],
        "text-size": 11,
        "symbol-placement": "line",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": "#3a8898",
        "text-halo-color": "#e8e6d8",
        "text-halo-width": 1
      },
      "minzoom": 12
    },
    {
      "id": "poi-park-label",
      "type": "symbol",
      "source": "mapbox",
      "source-layer": "poi_label",
      "filter": ["in", "class", "park", "landmark"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": 10,
        "text-max-width": 8,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#5a7a50",
        "text-halo-color": "#e8e6d8",
        "text-halo-width": 1.5
      },
      "minzoom": 10
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "mapbox",
      "source-layer": "place_label",
      "filter": ["==", "class", "town"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Medium", "Arial Unicode MS Regular"],
        "text-size": 12,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#4a4840",
        "text-halo-color": "#e8e6d8",
        "text-halo-width": 1.5
      },
      "minzoom": 8
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "mapbox",
      "source-layer": "place_label",
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 6, 12, 10, 16],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3a3830",
        "text-halo-color": "#e8e6d8",
        "text-halo-width": 2
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "mapbox",
      "source-layer": "place_label",
      "filter": ["==", "class", "state"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": 11,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#7a7870",
        "text-halo-color": "#e8e6d8",
        "text-halo-width": 1
      },
      "maxzoom": 8
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "mapbox",
      "source-layer": "place_label",
      "filter": ["==", "class", "country"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Pro Bold", "Arial Unicode MS Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 3, 11, 6, 14],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1,
        "text-max-width": 10
      },
      "paint": {
        "text-color": "#5a5850",
        "text-halo-color": "#e8e6d8",
        "text-halo-width": 1.5
      },
      "maxzoom": 7
    }
  ]
}
